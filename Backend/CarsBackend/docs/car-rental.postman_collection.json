{
  "info": {
    "name": "Car Rental API v1",
    "description": "Select individual requests after setting credentials, catalog identifiers, and image files. Mutation requests modify the selected records. All secret variables are blank in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "carSlug",
      "value": "toyota-corolla-demo-toyota-1",
      "type": "string"
    },
    {
      "key": "carId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "brandId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "pickupLocationId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "mediaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "blockedPeriodId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "pickupAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "returnAt",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"pickupAt\")) {",
          "  pm.collectionVariables.set(\"pickupAt\", new Date(Date.now() + 3 * 86400000).toISOString().replace(/\\.\\d{3}Z$/, \"Z\"));",
          "}",
          "if (!pm.collectionVariables.get(\"returnAt\")) {",
          "  pm.collectionVariables.set(\"returnAt\", new Date(Date.now() + 5 * 86400000).toISOString().replace(/\\.\\d{3}Z$/, \"Z\"));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Public catalog and booking",
      "item": [
        {
          "name": "Brands",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/brands"
          }
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Active locations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/locations"
          }
        },
        {
          "name": "Search cars",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/cars?brand=toyota&sort=price_asc&per_page=10"
          }
        },
        {
          "name": "Featured cars",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/cars/featured"
          }
        },
        {
          "name": "Car details by slug",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/cars/{{carSlug}}"
          }
        },
        {
          "name": "Submit pending guest request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"car_slug\": \"{{carSlug}}\",\n  \"customer_name\": \"Demo Customer\",\n  \"customer_phone\": \"+963991234567\",\n  \"customer_email\": \"demo@example.test\",\n  \"pickup_location_id\": \"{{pickupLocationId}}\",\n  \"pickup_at\": \"{{pickupAt}}\",\n  \"return_at\": \"{{returnAt}}\",\n  \"notes\": \"Demo rental request\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/booking-requests"
          }
        }
      ]
    },
    {
      "name": "Admin authentication and dashboard",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set(\"adminToken\", pm.response.json().data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/me"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "Logout and revoke token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/logout"
          }
        }
      ]
    },
    {
      "name": "Admin vehicles",
      "item": [
        {
          "name": "List all non-archived cars",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/cars?per_page=15"
          }
        },
        {
          "name": "Create car",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inventory_code\": \"DEMO-POSTMAN-{{$timestamp}}\",\n  \"brand_id\": \"{{brandId}}\",\n  \"category_id\": \"{{categoryId}}\",\n  \"location_id\": \"{{pickupLocationId}}\",\n  \"model\": \"320i\",\n  \"year\": 2024,\n  \"price_per_day\": \"95.00\",\n  \"currency\": \"USD\",\n  \"transmission\": \"automatic\",\n  \"fuel_type\": \"petrol\",\n  \"seats\": 5,\n  \"luggage_count\": 3,\n  \"is_published\": false,\n  \"is_featured\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/cars"
          }
        },
        {
          "name": "Editing details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/cars/{{carId}}"
          }
        },
        {
          "name": "Update car",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price_per_day\": \"99.50\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/cars/{{carId}}"
          }
        },
        {
          "name": "Operational status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operational_status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/cars/{{carId}}/status"
          }
        },
        {
          "name": "Featured flag",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_featured\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/cars/{{carId}}/featured"
          }
        },
        {
          "name": "Publication flag",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/cars/{{carId}}/publication"
          }
        },
        {
          "name": "Archive car",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/cars/{{carId}}"
          }
        }
      ]
    },
    {
      "name": "Admin images",
      "item": [
        {
          "name": "Upload images (select local files)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images[]",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "images[]",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/admin/cars/{{carId}}/images"
          }
        },
        {
          "name": "Select primary",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/cars/{{carId}}/images/{{mediaId}}/primary"
          }
        },
        {
          "name": "Reorder all owned images",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"media_ids\": [\n    1,\n    2\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/cars/{{carId}}/images/order"
          }
        },
        {
          "name": "Delete owned image",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/cars/{{carId}}/images/{{mediaId}}"
          }
        }
      ]
    },
    {
      "name": "Admin categories and locations",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Convertible\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Convertible\",\n  \"slug\": \"convertible\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/categories/{{categoryId}}"
          }
        },
        {
          "name": "Delete unused category",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/categories/{{categoryId}}"
          }
        },
        {
          "name": "List all locations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/locations"
          }
        },
        {
          "name": "Create location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Real airport office\",\n  \"city\": \"Damascus\",\n  \"country\": \"Syria\",\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/locations"
          }
        },
        {
          "name": "Update location",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/locations/{{pickupLocationId}}"
          }
        },
        {
          "name": "Delete unused location",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/locations/{{pickupLocationId}}"
          }
        }
      ]
    },
    {
      "name": "Admin bookings and unavailable periods",
      "item": [
        {
          "name": "List bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/bookings?status=pending&per_page=15"
          }
        },
        {
          "name": "Booking details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Create confirmed manual booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"car_slug\": \"{{carSlug}}\",\n  \"customer_name\": \"Demo Customer\",\n  \"customer_phone\": \"+963991234567\",\n  \"customer_email\": \"demo@example.test\",\n  \"pickup_location_id\": \"{{pickupLocationId}}\",\n  \"pickup_at\": \"{{pickupAt}}\",\n  \"return_at\": \"{{returnAt}}\",\n  \"notes\": \"Demo rental request\",\n  \"status\": \"confirmed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/bookings"
          }
        },
        {
          "name": "Transition booking status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/bookings/{{bookingId}}/status"
          }
        },
        {
          "name": "Create date block",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_at\": \"{{pickupAt}}\",\n  \"end_at\": \"{{returnAt}}\",\n  \"reason\": \"Scheduled maintenance\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/admin/cars/{{carId}}/blocked-periods"
          }
        },
        {
          "name": "Remove date block",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/blocked-periods/{{blockedPeriodId}}"
          }
        }
      ]
    }
  ]
}
