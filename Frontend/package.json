    "date-fns": "^4.4.0",
    "lucide-react": "^1.57.0",
    "motion": "^14.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "react-day-picker": "^9.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
